# ISG demo environment — copy to .env and fill in your credentials

# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./isg_demo.db
SECRET_KEY=isg-demo-key-sih2026-change-in-prod
DEMO_API_KEY=isg-demo-token-sih2026
ALLOWED_ORIGINS=http://localhost:3000

# ── DigiLocker (income / ITR pull) ──────────────────────────────────────────
# Register your app at https://developers.digilocker.gov.in
# Set DIGILOCKER_SANDBOX=false for production.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_SANDBOX=true
DIGILOCKER_REDIRECT_URI=http://localhost:8000/api/citizen/digilocker/callback

# ── UIDAI Aadhaar verification ───────────────────────────────────────────────
# Register at https://uidai.gov.in/ecosystem/authentication-devices-documents/aua-kua-registration.html
# Set UIDAI_SANDBOX=false for production.
UIDAI_AUA_CODE=
UIDAI_API_KEY=
UIDAI_SANDBOX=true
